      "metadata": {
        "split_group": "reseller_forwarding_failure"
      },
      "narrative": "The consumer disputed a mortgage tradeline through a reseller. The reseller determined that the item came from the source CRA and was not due to reseller error. The reseller conveyed the dispute packet to the source CRA on the eighth business day, not within 5 business days, and never reconveyed the source CRA's completion notice to the consumer. The source CRA itself completed a reasonable reinvestigation, notified the furnisher timely, verified the item, recorded current status, and sent a timely results notice.\n",
      "provenance": "authored",
      "structured_fields": {},
      "title": "Reseller forwards source-CRA dispute late and never reconveys"
    }
