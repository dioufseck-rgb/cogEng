      "metadata": {
        "split_group": "expedited_deletion"
      },
      "narrative": "A consumer disputed a small collection tradeline directly with the CRA, identified the item and basis, and supplied enough identity information. Within 3 business days, before sending any furnisher notice, the CRA deleted the disputed item from the consumer's file, telephoned the consumer with notice of the expedited deletion, and sent written confirmation. The CRA recorded current deleted status and no reinsertion occurred. Because the item was deleted through the expedited path, no furnisher transmission was sent. No direct-furnisher, reseller, or consumer-statement branch applies.\n",
      "provenance": "authored",
      "structured_fields": {},
      "title": "Expedited deletion without furnisher notice"
    },
